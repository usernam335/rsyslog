Vagrant.configure("2") do |config|

  # Конфигурация для веб-сервера
  config.vm.define "web" do |web|
    web.vm.box = "ubuntu/jammy64"
    web.vm.hostname = "web"
    web.vm.network "private_network", ip: "192.168.56.10"

    web.vm.provision "shell", inline: <<-SHELL
      apt-get update
      apt-get install -y nginx
      apt-get install -y ansible
    SHELL
  end
 
  # Конфигурация для лог-сервера
  config.vm.define "log" do |log|
    log.vm.box = "ubuntu/jammy64"
    log.vm.hostname = "log"
    log.vm.network "private_network", ip: "192.168.56.15"

    log.vm.provision "shell", inline: <<-SHELL
      apt-get update
    SHELL

    # Запускаем Ansible на хосте, когда машина log будет готова
    log.vm.provision "ansible" do |ansible|
      ansible.playbook = "ansible-playbook.yml"
      ansible.inventory_path = "inventory.ini"
      ansible.host_key_checking = "false"
      ansible.limit = "all"
    end
  end

end
